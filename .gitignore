# Deny by default: only what is explicitly allowed below can be added to git.
# The repo ships ONLY what the end user / AI agent needs. Development tooling
# (tests, CI, Docker, benchmarks, internal docs) lives on the maintainer's
# machine and is intentionally not published.
/*
!/.claude-plugin/
!/.claude-plugin/**
!/service/
!/service/**
!/skills/remove-ai-marks/
!/skills/remove-ai-marks/**
!/AGENTS.md
!/CODE_OF_CONDUCT.md
!/GUIA_USUARIO.md
!/install.sh
!/install.ps1
!/instalar-asistente.bat
!/instalar-asistente.command
!/integrations/
!/integrations/**
!/LICENSE
!/NOTICE
!/package.json
!/plugin.json
!/README.md
!/SECURITY.md
!/skills.json
!/skills/clean-user-facing-text/
!/skills/clean-user-facing-text/**

# Exceptions even inside allowed trees
.env
**/__pycache__/
*.pyc
.venv/
.firecrawl/
.figlet/
posts.md
*.cleaned.*
*.bak

# Docker path is not shipped (agents run Python directly)
/service/Dockerfile*
/service/.dockerignore
