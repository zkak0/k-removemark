# Deny by default: only what is explicitly allowed below can be added to git.
# The repo ships the end-user/agent surface (service, skills, integrations,
# launchers, manifests) plus the development tooling that makes the project
# verifiable by anyone who clones it: tests, CI, lint config, benchmarks.
# Still deliberately NOT published: Docker images, internal docs/ and the
# maintainer-only dotfiles (.venv, .env, caches).
/*
!/.claude-plugin/
!/.claude-plugin/**
!/.gitattributes
!/service/
!/service/**
!/skills/
!/skills/remove-ai-marks/
!/skills/remove-ai-marks/**
!/AGENTS.md
!/CODE_OF_CONDUCT.md
!/GUIA_USUARIO.md
!/actualizar-asistente.bat
!/actualizar-asistente.command
!/desinstalar.ps1
!/desinstalar.sh
!/desinstalar-asistente.bat
!/desinstalar-asistente.command
!/install.sh
!/install.ps1
!/instalar-asistente.bat
!/instalar-asistente.command
!/limpiar-servicio.bat
!/limpiar-servicio.command
!/integrations/
!/integrations/**
!/LICENSE
!/NOTICE
!/package.json
!/plugin.json
!/README.md
!/SECURITY.md
!/skills.json
!/skills/clean-user-facing-text/
!/skills/clean-user-facing-text/**

# Development tooling: published so any clone can run and verify the project.
!/tests/
!/tests/**
!/benchmarks/
!/benchmarks/**
!/.github/
!/.github/**
!/Makefile
!/requirements-dev.txt
!/ruff.toml
!/pytest.ini

# Exceptions even inside allowed trees
.env
**/__pycache__/
*.pyc
.venv/
.firecrawl/
.figlet/
posts.md
*.cleaned.*
*.bak

# Docker path is not shipped: the images bake upstream code whose licenses are
# not redistributable (see compose.yaml), and agents run Python directly.
# The image-publishing workflow therefore stays unpublished too.
/service/Dockerfile*
/service/.dockerignore
/.github/workflows/release-images.yml
/compose.yaml
/compose-check.sh
